# 用法：把本文件复制成 .env 再填值。.env 已被 .gitignore 忽略，不会进仓库。
# 本文件里只放"字段长什么样"的示例，不要写真实 Key。

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=please_replace_with_a_random_string
TOKEN_EXPIRE_MINUTES=720

# ---- 数据库（留空则自动使用 data/scanner.db） ----
# DATABASE_URL=sqlite:///data/scanner.db

# ---- 扫描安全约束 ----
SCAN_RATE_LIMIT_PER_SECOND=5
SCAN_MAX_CONCURRENCY=3
PAYLOAD_EXEC_TIMEOUT=30
AGENT_MAX_ROUND=15
AGENT_FAIL_SWAP_THRESHOLD=3
AGENT_MAX_SWAP_TIMES=2

# ---- 默认主控模型（仅作为首次启动的兜底，正式配置以系统"配置"页为准） ----
MAIN_MODEL_PROVIDER=deepseek
MAIN_MODEL_NAME=deepseek-chat
MAIN_MODEL_API_KEY=
MAIN_MODEL_BASE_URL=https://api.deepseek.com/v1

# ---- 默认顾问模型（collaboration_mode=dual 时才用） ----
ADVISOR_MODEL_PROVIDER=deepseek
ADVISOR_MODEL_NAME=deepseek-chat
ADVISOR_MODEL_API_KEY=
ADVISOR_MODEL_BASE_URL=https://api.deepseek.com/v1

COLLABORATION_MODE=single
